{
  "name": "kiosk-workspace",
  "description": "Self-service kiosk: ui/ (screens, UI updates) + app/ (Electron, app updates)",
  "private": true,
  "type": "module",
  "workspaces": [
    "ui",
    "app"
  ],
  "scripts": {
    "dev": "npm run dev -w ui",
    "build": "npm run build -w ui",
    "preview": "npm run preview -w ui",
    "electron": "node scripts/start-electron.js",
    "electron:window": "node scripts/start-electron.js --windowed",
    "electron:prod": "npm run build && node scripts/start-electron.js --prod",
    "dist": "npm run build && npm run dist -w app",
    "serve-updates": "node scripts/serve-updates.js",
    "serve-ui": "node scripts/serve-ui.js",
    "what-changed": "node scripts/what-changed.js",
    "lint": "eslint ."
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0"
  }
}
